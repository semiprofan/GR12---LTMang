<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phòng Chat Nhóm 12"
        Height="450"
        Width="600">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- USERNAME -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Biệt danh:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtUsername" Width="150" Text="DatDao" Padding="5"/>
        </StackPanel>

        <!-- CHAT LIST -->
        <ListBox x:Name="lstMessages" Grid.Row="1" Margin="0,0,0,10"/>

        <!-- INPUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtMessage"
                     Grid.Column="0"
                     Padding="5"
                     Margin="0,0,5,0"
                     KeyDown="txtMessage_KeyDown"/>

            <Button x:Name="btnSend"
                    Grid.Column="1"
                    Content="Gửi"
                    Width="80"
                    Height="30"
                    Click="btnSend_Click"/>
        </Grid>

    </Grid>
</Window>